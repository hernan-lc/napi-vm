{
  "name": "@napi-vm/plugin-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "napi-vm-plugin": "./src/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "templates",
    "scripts"
  ],
  "dependencies": {
    "@napi-vm/plugin-codegen": "0.1.0",
    "@napi-vm/plugin-host": "0.1.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "types": "./src/index.d.mts",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:templates": "node scripts/sync-assets.mjs",
    "prepack": "node scripts/sync-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
