{
  "name": "napi-vm",
  "version": "0.1.0",
  "description": "A sandboxed JavaScript virtual machine built from scratch in Rust with NAPI bindings for Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "npx napi build --platform --release",
    "build:debug": "npx napi build --platform",
    "test": "bun test",
    "bench": "node bench/bench.js",
    "bench:stress": "bun bench/stress.ts",
    "bench:rust": "cargo bench",
    "playground:build": "wasm-pack build --target web --out-dir playground/pkg --release -- --no-default-features --features wasm",
    "playground": "vite --config playground/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nglmercer/napi-vm.git"
  },
  "homepage": "https://github.com/nglmercer/napi-vm#readme",
  "bugs": {
    "url": "https://github.com/nglmercer/napi-vm/issues"
  },
  "keywords": [
    "vm",
    "sandbox",
    "javascript",
    "interpreter",
    "rust",
    "napi",
    "native",
    "ecmascript",
    "execution",
    "isolated"
  ],
  "author": "nglmercer",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "napi": {
    "binaryName": "napi-vm",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "vite": "^8.2.0"
  }
}
