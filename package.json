{
  "name": "napi-vm",
  "version": "0.1.0",
  "description": "A sandboxed JS VM runtime built from scratch in Rust with NAPI bindings",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "build": "npx napi build --platform --release",
    "build:debug": "npx napi build --platform",
    "test": "bun test",
    "bench": "node bench/bench.js",
    "bench:rust": "cargo bench"
  },
  "napi": {
    "binaryName": "napi-vm",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2"
  }
}
