{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AddInput": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "amount"
      ],
      "additionalProperties": false
    },
    "Count": {
      "type": "object",
      "properties": {
        "count": {
          "type": "string",
          "x-wire-type": "i64-decimal"
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
}
