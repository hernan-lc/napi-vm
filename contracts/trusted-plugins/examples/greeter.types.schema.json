{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GreetInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "GreetOutput": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "InvalidNameData": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
