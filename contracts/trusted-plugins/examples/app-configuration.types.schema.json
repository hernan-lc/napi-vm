{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GetInput": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    },
    "GetOutput": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    }
  }
}
