{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://napi-vm.invalid/trusted-plugins/manifest.schema.json",
  "title": "Trusted process plugin manifest v1",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "const": 2
    },
    "execution": {
      "const": "trusted-process"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "protocol": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "major",
        "minMinor",
        "maxMinor"
      ],
      "additionalProperties": false
    },
    "provides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      },
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
      }
    },
    "requiresHost": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      },
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
      }
    },
    "launch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "javascript"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
            },
            "runtimes": {
              "type": "array",
              "items": {
                "enum": [
                  "bun",
                  "node"
                ]
              },
              "maxItems": 2,
              "minItems": 1,
              "uniqueItems": true
            },
            "preferredRuntime": {
              "enum": [
                "bun",
                "node"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "maxItems": 64
            },
            "versions": {
              "type": "object",
              "properties": {
                "node": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^(>=)?\\d+\\.\\d+\\.\\d+$"
                },
                "bun": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^(>=)?\\d+\\.\\d+\\.\\d+$"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "entry",
            "runtimes",
            "preferredRuntime"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "preferredRuntime": {
                    "const": "node"
                  }
                }
              },
              "then": {
                "properties": {
                  "runtimes": {
                    "contains": {
                      "const": "node"
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "preferredRuntime": {
                    "const": "bun"
                  }
                }
              },
              "then": {
                "properties": {
                  "runtimes": {
                    "contains": {
                      "const": "bun"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "executable"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
            },
            "target": {
              "type": "object",
              "properties": {
                "os": {
                  "enum": [
                    "linux",
                    "darwin",
                    "win32"
                  ]
                },
                "arch": {
                  "enum": [
                    "x64",
                    "arm64"
                  ]
                },
                "libc": {
                  "enum": [
                    "gnu",
                    "musl"
                  ]
                }
              },
              "required": [
                "os",
                "arch"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "os": {
                        "const": "linux"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "libc"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "libc"
                      ]
                    }
                  }
                }
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "maxItems": 64
            }
          },
          "required": [
            "kind",
            "entry",
            "target"
          ],
          "additionalProperties": false
        }
      ]
    },
    "development": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "runtime": {
          "enum": [
            "node",
            "bun"
          ]
        }
      },
      "required": [
        "entry",
        "runtime"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
      },
      "maxItems": 1024
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
      },
      "maxItems": 1024
    },
    "profile": {
      "enum": [
        "portable-js",
        "external-runtime",
        "native-executable"
      ]
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "native": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
              },
              "target": {
                "type": "object",
                "properties": {
                  "os": {
                    "enum": [
                      "linux",
                      "darwin",
                      "win32"
                    ]
                  },
                  "arch": {
                    "enum": [
                      "x64",
                      "arm64"
                    ]
                  },
                  "libc": {
                    "enum": [
                      "gnu",
                      "musl"
                    ]
                  }
                },
                "required": [
                  "os",
                  "arch"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "os": {
                          "const": "linux"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "libc"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "libc"
                        ]
                      }
                    }
                  }
                ]
              },
              "abi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "runtime": {
                "enum": [
                  "node",
                  "bun"
                ]
              },
              "status": {
                "enum": [
                  "tested",
                  "buildable",
                  "distributed"
                ]
              }
            },
            "required": [
              "name",
              "path",
              "target",
              "abi",
              "runtime",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
              },
              "kind": {
                "enum": [
                  "http",
                  "mcp"
                ]
              },
              "owner": {
                "enum": [
                  "external",
                  "host"
                ]
              },
              "readiness": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^/"
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  }
                },
                "required": [
                  "path",
                  "status"
                ],
                "additionalProperties": false
              },
              "shutdown": {
                "const": "terminate"
              }
            },
            "required": [
              "name",
              "kind"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "owner": {
                      "const": "host"
                    }
                  },
                  "required": [
                    "owner"
                  ]
                },
                "then": {
                  "required": [
                    "readiness",
                    "shutdown"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "readiness"
                        ]
                      },
                      {
                        "required": [
                          "shutdown"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "maxItems": 64
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "maxItems": 64
        }
      },
      "required": [
        "native",
        "services",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "manifestVersion",
    "execution",
    "id",
    "version",
    "protocol",
    "provides",
    "requiresHost",
    "launch"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "portable-js"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "dependencies": {
            "properties": {
              "native": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
